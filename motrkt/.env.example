# Copy to .env (never commit .env). Restart `npm run dev` after changes.

# AI Co-Pilot (Claude) – optional; without it the local analysis mode answers.
ANTHROPIC_API_KEY=

# mobile.de Search API ("Ad-Integration") – credentials from mobile.de customer support
# https://services.mobile.de/docs/search-api.html · +49 30 81097500
MOBILEDE_USERNAME=
MOBILEDE_PASSWORD=

# Demo-Konto (siehe README): in der Entwicklung an (0 = aus), im Produktionsserver nur mit 1
# MIP_DEMO_ACCOUNT=1

# Postgres for the market data: npm run db:migrate (schema), npm run db:import (load src/data/real)
# Local: postgres://localhost:5432/mip · hosted: the pooled connection string of the Vercel/Neon database
DATABASE_URL=

# Schlüssel für hochgeladene Kaufverträge (AES-256, server/contractVault.ts): openssl rand -base64 32
# Auf Vercel Pflicht: ohne ihn wird kein Vertrag angenommen. Lokal ohne Schlüssel: unverschlüsselt, nur zum Testen.
# Nicht verlieren und nicht ändern, solange Meldungen offen sind (sonst müssen die Nutzer neu hochladen).
MIP_CONTRACT_KEY=

# Prüfer der gemeldeten Fahrzeuge (/pruefung), Benutzernamen kommagetrennt
# MIP_ADMINS=

# npm start hinter eigenem Reverse-Proxy: Client-Adresse aus X-Forwarded-For lesen (auf Vercel nicht nötig)
# MIP_TRUST_PROXY=1

# E-Mails zum Konto (Code bei der Registrierung, Bestätigung, Passwort zurücksetzen) über Resend, server/mail.ts. Ohne Schlüssel lokal: die Mail
# erscheint in der Konsole. MIP_PUBLIC_URL ist die Adresse in den Links und für den Rückweg von Stripe (auf Vercel sonst https://www.cartag.info).
# RESEND_API_KEY=
# MAIL_FROM=konto@cartag.info
# MAIL_FROM_NAME=Cartag
# MIP_PUBLIC_URL=https://www.cartag.info

# Premium kaufen über Stripe (server/payments.ts, README „Bezahlen“). Ohne Schlüssel und Preis gibt es keinen Kauf,
# nur den Kaufvertrag. Der Preis entscheidet: wiederkehrend (pro Monat oder Jahr) ist ein Abo, einmalig ist eine
# Zahlung für 12 Monate (oder Metadaten "months"). Webhook: https://<domain>/api/stripe/webhook mit
# checkout.session.completed, checkout.session.async_payment_succeeded, invoice.paid, charge.refunded und
# customer.subscription.deleted. STRIPE_PRICE_ID_YEARLY: ein zweiter Preis, Abo pro Jahr, zur Wahl neben einem
# Abo-Preis mit kürzerem Zeitraum (z. B. pro Monat) in derselben Währung; ohne ihn bleibt es bei einem Preis.
# Vorher: npm run db:migrate (014_payments.sql, 015_subscriptions.sql).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_PRICE_ID_YEARLY=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_REQUIRE_TERMS=1     # Käufer bestätigt die in Stripe hinterlegten AGB
# STRIPE_AUTOMATIC_TAX=1     # Stripe Tax berechnet die Umsatzsteuer
# STRIPE_PROMO_CODES=1       # Feld für Gutscheincodes auf der Zahlungsseite
