# Copy to .env (never commit .env). Restart `npm run dev` after changes.

# AI Co-Pilot (Claude) – optional; without it the local analysis mode answers.
ANTHROPIC_API_KEY=

# mobile.de Search API ("Ad-Integration") – credentials from mobile.de customer support
# https://services.mobile.de/docs/search-api.html · +49 30 81097500
MOBILEDE_USERNAME=
MOBILEDE_PASSWORD=

# Demo-Konto (siehe README): in der Entwicklung an (0 = aus), im Produktionsserver nur mit 1
# MIP_DEMO_ACCOUNT=1

# Postgres for the market data: npm run db:migrate (schema), npm run db:import (load src/data/real)
# Local: postgres://localhost:5432/mip · hosted: the pooled connection string of the Vercel/Neon database
DATABASE_URL=
