{
  "name": "mip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/prod.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:prod": "tsx scripts/db/migrate.ts --prod",
    "db:import": "tsx scripts/db/import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.11.3",
    "lucide-react": "^1.69.0",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
